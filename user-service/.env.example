# ---- user-service ----
PORT=5001

# Same Atlas cluster as billing-service is fine; DB_NAME keeps the data separate.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=rentbook_users

# Must be IDENTICAL in both services (billing-service verifies the same tokens).
JWT_SECRET=change-me-to-a-long-random-string

# Shared secret for /internal routes. Must be IDENTICAL in both services.
SERVICE_KEY=change-me-internal-key

# Where billing-service lives (used before deleting a property).
BILLING_SERVICE_URL=http://localhost:5002

# Optional: comma-separated list of allowed frontend origins. Empty = allow all.
CLIENT_ORIGIN=

# Optional: how long to wait for the other service (ms). Render free tier can take ~50s to wake.
SERVICE_TIMEOUT_MS=20000
