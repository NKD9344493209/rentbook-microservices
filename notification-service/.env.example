# ---- notification-service ----
PORT=5003

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=rentbook_notifications

# Must be IDENTICAL in all three services.
JWT_SECRET=change-me-to-a-long-random-string
SERVICE_KEY=change-me-internal-key

USER_SERVICE_URL=http://localhost:5001
BILLING_SERVICE_URL=http://localhost:5002

# Telegram bot token from @BotFather. Leave EMPTY to run in "console mode":
# messages are stored in the in-app feed and printed to the terminal instead of sent.
TELEGRAM_BOT_TOKEN=
# Bot username without @ (shown in the app's "Connect Telegram" page), e.g. RentBookAlertsBot
TELEGRAM_BOT_USERNAME=

# Deployed URL of THIS service (no trailing slash). When set, the bot uses a webhook
# (works on Render free tier). Leave empty locally: the bot polls Telegram instead.
PUBLIC_URL=

# Daily digest time (cron, server time is UTC on Render). 03:30 UTC = 9:00 AM IST.
DIGEST_CRON=30 3 * * *
# Days before due date to remind tenants
REMIND_DAYS_BEFORE=2

CLIENT_ORIGIN=
SERVICE_TIMEOUT_MS=20000
