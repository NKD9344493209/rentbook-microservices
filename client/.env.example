# Leave both empty for local development (Vite proxies to localhost:5001 / 5002).
# On Vercel set them to the deployed services, ending in /api:
VITE_USER_API_URL=https://<your-user-service>.onrender.com/api
VITE_BILLING_API_URL=https://<your-billing-service>.onrender.com/api
VITE_NOTIFY_API_URL=https://<your-notification-service>.onrender.com/api
