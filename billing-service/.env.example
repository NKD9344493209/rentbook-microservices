# ---- billing-service ----
PORT=5002

# Same Atlas cluster as user-service is fine; DB_NAME keeps the data separate.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=rentbook_billing

# Must be IDENTICAL to user-service (this service verifies tokens user-service issues).
JWT_SECRET=change-me-to-a-long-random-string

# Shared secret for /internal routes. Must be IDENTICAL in both services.
SERVICE_KEY=change-me-internal-key

# Where user-service lives (tenant checks, names, properties).
USER_SERVICE_URL=http://localhost:5001

# Where notification-service lives (events: bill issued/paid, complaints). Optional: leave empty to disable alerts.
NOTIFICATION_SERVICE_URL=http://localhost:5003

# Optional: comma-separated list of allowed frontend origins. Empty = allow all.
CLIENT_ORIGIN=

# Optional: how long to wait for the other service (ms). Render free tier can take ~50s to wake.
SERVICE_TIMEOUT_MS=20000
